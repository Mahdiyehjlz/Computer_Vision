# ====================== 3. PROCESS ANNOTATIONS ======================
def process_annotations():
    # Extract classes
    classes = set()
    with open(annotations_file, 'r') as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) >= 6:
                classes.add(parts[-1])

    classes = sorted(classes)
    class_to_id = {cls: idx for idx, cls in enumerate(classes)}

    # Group annotations by image
    image_data = {}
    with open(annotations_file, 'r') as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 6: continue
            img_name = parts[0]
            bbox = list(map(int, parts[1:5]))
            cls_name = parts[5]
            if img_name not in image_data:
                image_data[img_name] = []
            image_data[img_name].append((bbox, cls_name))

    return classes, class_to_id, image_data

classes, class_to_id, image_data = process_annotations()
# ====================== 4. COPY IMAGES AND CREATE LABELS ======================
def process_images(split):
    source_dir = source_images[split]
    dest_img_dir = os.path.join(base_dir, "images", split)
    dest_label_dir = os.path.join(base_dir, "labels", split)

    image_list = []

    for img_file in os.listdir(source_dir):
        img_base = os.path.splitext(img_file)[0]

        # Skip if no annotations
        if img_base not in image_data:
            continue

        img_path = os.path.join(source_dir, img_file)
        dest_img_path = os.path.join(dest_img_dir, img_file)

        # Copy image if not exists
        if not os.path.exists(dest_img_path):
            shutil.copy(img_path, dest_img_path)

        # Get image dimensions
        with Image.open(img_path) as img:
            width, height = img.size

        # Create label file
        label_file = os.path.join(dest_label_dir, f"{img_base}.txt")
        if not os.path.exists(label_file):
            with open(label_file, 'w') as lf:
                for (x_min, y_min, x_max, y_max), cls_name in image_data[img_base]:
                    # Convert to YOLO format
                    cx = (x_min + x_max) / (2 * width)
                    cy = (y_min + y_max) / (2 * height)
                    w = (x_max - x_min) / width
                    h = (y_max - y_min) / height
                    cls_id = class_to_id[cls_name]
                    lf.write(f"{cls_id} {cx:.6f} {cy:.6f} {w:.6f} {h:.6f}\n")

        # Add to image list
        image_list.append(dest_img_path)

    # Create train/val.txt files
    list_file = os.path.join(base_dir, f"{split}.txt")
    with open(list_file, 'w') as f:
        f.write("\n".join(image_list))

    print(f"Processed {len(image_list)} {split} images")

process_images('train')
process_images('val')
