# ====================== 6. VERIFY PATHS ======================
def verify_paths():
    print("\nVerifying paths...")
    issues = 0

    for split in ['train', 'val']:
        list_file = os.path.join(base_dir, f"{split}.txt")
        if not os.path.exists(list_file):
            print(f"Missing {list_file}")
            continue

        with open(list_file) as f:
            for line in f:
                img_path = line.strip()
                if not os.path.exists(img_path):
                    print(f"Missing image: {img_path}")
                    issues += 1

                # Replace image extension with .txt for label file
                for ext in ['.jpg', '.jpeg', '.png']:
                    if img_path.endswith(ext):
                        label_path = img_path.replace('images', 'labels').replace(ext, '.txt')
                        break
                else:
                    print(f"Unrecognized image extension: {img_path}")
                    issues += 1
                    continue

                if not os.path.exists(label_path):
                    print(f"Missing label: {label_path}")
                    issues += 1

    print(f"Verification complete. Found {issues} issues.")
    return issues == 0

if not verify_paths():
    raise ValueError("Path verification failed! Please check your dataset structure.")
